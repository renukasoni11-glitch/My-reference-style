
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">

  <info>
    <title>Renuka Custom Superscript Bibliography</title>
    <id>http://www.zotero.org/styles/renuka-custom-superscript</id>
    <link href="http://www.zotero.org/styles/renuka-custom-superscript" rel="self"/>
    <category citation-format="numeric"/>
    <category field="chemistry"/>
    <summary>Superscript numerical citations with complete author names, article title, journal, year, volume, pages and DOI.</summary>
    <updated>2026-10-30T00:00:00+00:00</updated>
  </info>

  <!-- IN-TEXT CITATIONS -->
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- BIBLIOGRAPHY -->
  <bibliography>
    <sort>
      <key variable="citation-number"/>
    </sort>

    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>

      <group delimiter=", ">

        <!-- AUTHORS -->
        <names variable="author" delimiter=", ">
          <name initialize-with=". "
                and="text"
                delimiter-precedes-last="never"
                et-al-min="999"
                et-al-use-first="999"/>
          <substitute>
            <names variable="editor"/>
            <text variable="title"/>
          </substitute>
        </names>

        <!-- ARTICLE TITLE -->
        <text variable="title"/>

        <!-- JOURNAL NAME -->
        <text variable="container-title" font-style="italic"/>

        <!-- YEAR -->
        <date variable="issued">
          <date-part name="year"/>
        </date>

        <!-- VOLUME -->
        <text variable="volume" font-weight="bold"/>

        <!-- PAGE NUMBERS -->
        <text variable="page"/>

        <!-- DOI -->
        <choose>
          <if variable="DOI">
            <text variable="DOI" prefix="https://doi.org/"/>
          </if>
        </choose>

      </group>
    </layout>
  </bibliography>

</style>
